# Postgres connection string. For local dev, point at a local Postgres.
# For production, use your Supabase project's connection string
# (Project Settings -> Database -> Connection string -> URI, "Transaction"
# pooling mode works well for serverless/Vercel deployments).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rowtracker?schema=public"

# Email used to identify the single seeded user. No auth in the MVP, so
# every workout is attributed to this account.
DEFAULT_USER_EMAIL="you@example.com"
