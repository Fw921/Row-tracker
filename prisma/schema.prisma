// Prisma schema for Row Tracker — a rowing performance analytics platform.
//
// The MVP runs single-user (everything hangs off one seeded `User` row,
// no auth yet), but every table is already keyed by `userId` so adding
// real accounts later is additive, not a rewrite.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A rower. Single row for now; ready for multi-user auth later.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())

  workouts      Workout[]
  importBatches ImportBatch[]
  athletes      Athlete[]
  pieceGroups   PieceGroup[]
  goals         Goal[]
  boats         Boat[]

  @@map("users")
}

/// A teammate on the account owner's roster — a coxswain/coach logs pieces
/// for these people. Not a login: just a name to attribute results to, so
/// the whole boat's erg piece can be entered in one batch.
model Athlete {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  archived  Boolean     @default(false) // hide from pickers without losing history
  side      RowingSide? // rigging preference, shown as a color cue in the boat builder
  createdAt DateTime    @default(now())

  workouts  Workout[]
  boatSeats BoatSeat[]

  @@unique([userId, name])
  @@map("athletes")
}

/// A rower's rigging-side preference — shown as a color cue (red/green,
/// the same convention as a boat's port/starboard running lights) in the
/// boat builder, so a lopsided lineup is obvious at a glance. EITHER
/// covers a rower who can go either side.
enum RowingSide {
  PORT
  STARBOARD
  EITHER
}

/// Which boat class a Boat is — drives how many rowing seats it has and
/// whether it carries a coxswain. See src/lib/boats.ts for the seat
/// count/labels derived from each value.
enum BoatClass {
  EIGHT_PLUS // 8+
  FOUR_PLUS // 4+
  FOUR_MINUS // 4-
  FOUR_X // 4x, quad scull
  PAIR // 2-
  DOUBLE // 2x
  SINGLE // 1x
}

/// A lineup you're building or have built — a boat class plus a seat chart
/// of who's rowing where. Nothing here affects logged workouts/results; it's
/// purely for planning who rows together, iCrew-style.
model Boat {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String? // optional custom label, e.g. "Varsity 8 - Sat lineup"
  boatClass BoatClass
  createdAt DateTime  @default(now())

  seats BoatSeat[]

  @@index([userId])
  @@map("boats")
}

/// One seat in a Boat's lineup. `seatIndex` is 0-based bow-to-stroke among
/// rowing seats; -1 is the sentinel for the coxswain's seat (only present
/// on boats whose class has one — see BOAT_CLASS_INFO). A seat is exactly
/// one of: open (`athleteId` and `guestName` both null), a roster athlete,
/// or a guest tile (`guestName` set instead — a visiting rower/recruit with
/// no roster profile) — enforced in the seats PATCH route, not the schema.
model BoatSeat {
  id        String   @id @default(cuid())
  boatId    String
  boat      Boat     @relation(fields: [boatId], references: [id], onDelete: Cascade)
  seatIndex Int
  athleteId String?
  athlete   Athlete? @relation(fields: [athleteId], references: [id], onDelete: SetNull)
  guestName String?

  @@unique([boatId, seatIndex])
  @@map("boat_seats")
}

/// One "everybody rows the same piece" event — the shared parameters a
/// coxswain sets once (date, distance/time, title) before entering each
/// rower's individual result. Lets the erg-room leaderboard be an exact
/// query instead of guessing which workouts belong together.
model PieceGroup {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date  DateTime
  type  WorkoutType
  title String?

  targetDistanceMeters Float? // set for fixed-distance pieces (e.g. 2k)
  targetTimeSeconds    Float? // set for fixed-time pieces (e.g. 20')

  createdAt DateTime @default(now())

  workouts Workout[]

  @@index([userId, date])
  @@map("piece_groups")
}

/// What a Goal's target/progress numbers mean — drives which fields on it
/// are set and how the dashboard computes "current" against them.
enum GoalType {
  SPLIT_TARGET // beat a split at a given distance bucket, e.g. sub-7:00 2k
  TOTAL_METERS // cumulative distance across all logged workouts
  MONTHLY_WORKOUTS // workouts logged in the current calendar month
}

/// A rower-set target shown on the Goals card. Only the target is stored —
/// "current" and percent-complete are always derived from Workout data at
/// render time, so a goal can never drift out of sync with the log.
model Goal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type  GoalType
  label String? // optional custom display label, e.g. "Sub-7:00 2K"

  targetDistanceMeters   Float? // SPLIT_TARGET: which bucket (500, 2000, ...)
  targetSplitSeconds500m Float? // SPLIT_TARGET: split to beat
  targetMeters           Float? // TOTAL_METERS
  targetWorkoutsPerMonth Int? // MONTHLY_WORKOUTS

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("goals")
}

/// How a workout's data got into the system.
enum DataSource {
  MANUAL
  CONCEPT2_CSV
}

/// Shape of the logged session, drives which fields/charts make sense.
enum WorkoutType {
  SINGLE_DISTANCE // e.g. a 2k or 5k test piece, fixed meters
  SINGLE_TIME // e.g. a 30' steady state, fixed duration
  INTERVALS // e.g. 4x500m/3'r
  STEADY_STATE // continuous, unbroken row
  OTHER
}

/// One logged erg session — a test piece, a steady state row, an interval
/// workout, etc. Aggregate totals live here; per-split detail (for pacing
/// comparisons) lives in `Split`.
model Workout {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date        DateTime
  type        WorkoutType
  title       String? // e.g. "2k Test", "6x500m/3'r" — free text label
  description String?

  totalDistanceMeters Float // sum across all work intervals
  totalTimeSeconds    Float // sum across all work intervals, elapsed erg time
  avgSplitSeconds500m Float // derived: totalTimeSeconds / totalDistanceMeters * 500

  avgWatts      Float?
  avgHeartRate  Int?
  maxHeartRate  Int?
  avgStrokeRate Float?
  dragFactor    Int?
  calories      Float?

  source        DataSource   @default(MANUAL)
  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  // Null athleteId = the account owner's own piece (the original single-user
  // flow). Set = logged on behalf of a roster teammate, usually as part of
  // a PieceGroup entered in one batch.
  athleteId    String?
  athlete      Athlete?    @relation(fields: [athleteId], references: [id], onDelete: SetNull)
  pieceGroupId String?
  pieceGroup   PieceGroup? @relation(fields: [pieceGroupId], references: [id], onDelete: SetNull)

  notes String?

  splits Split[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@index([userId, type])
  @@index([athleteId, date])
  @@index([pieceGroupId])
  @@map("workouts")
}

/// A sub-piece within a workout: one interval's work, or one pacing split
/// (e.g. each 500m of a 2k). Lets us chart negative/positive splits and
/// compare pacing strategy across pieces of the same nominal distance.
model Split {
  id        String  @id @default(cuid())
  workoutId String
  workout   Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  index            Int // 1-based order within the workout
  distanceMeters   Float
  timeSeconds      Float
  splitSeconds500m Float // derived: timeSeconds / distanceMeters * 500

  restTimeSeconds    Float?
  restDistanceMeters Float?

  avgWatts      Float?
  avgHeartRate  Int?
  avgStrokeRate Float?

  @@unique([workoutId, index])
  @@map("splits")
}

/// One CSV upload event, so imported workouts can be traced back to the
/// file they came from (and re-import can be made idempotent later).
model ImportBatch {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  source     DataSource
  filename   String
  rowCount   Int
  importedAt DateTime   @default(now())

  workouts Workout[]

  @@map("import_batches")
}
